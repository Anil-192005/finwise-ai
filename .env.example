# ==========================================
# FinWise AI — Environment Configuration
# ==========================================

# Backend Configuration
PROJECT_NAME="FinWise AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Production Secret Key (Change this in production)
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
# Local Development (SQLite):
DATABASE_URL="sqlite:///./finwise.db"
# Production (Managed PostgreSQL on Render/Railway/AWS RDS):
# DATABASE_URL="postgresql://finwise_user:secure_password@db.railway.app:5432/finwise"

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Optional AI API Key (Rule-based engine operates 100% offline without it)
AI_API_KEY=""

# Frontend Configuration (in frontend/.env)
VITE_API_URL="http://localhost:8000/api/v1"
